# Identifies this machine to the central clients registry - must match the
# clientId used for this site there. Only needed the first time discovery
# runs on a machine; after that it's read back from sites.json.
CLIENT_ID=

# This machine's Tomcat instance folder(s) - each one is a direct install
# root containing conf\server.xml and the appBase folder (webapps, webapps1,
# ...). Comma-separated if this machine runs more than one instance (e.g.
# production plus a test site each get their own Tomcat instance - see
# server.xml's <Connector port> + <Host appBase>).
TOMCAT_FOLDER_PATH=D:\TomCat9

# This machine's base URL - scheme + host, no port, no trailing slash.
# Discovery appends each site's own Connector port (and /ords/ for the API
# URL) to build REACT_APP_BASE_URL/REACT_APP_API_URL, instead of trusting
# whatever happened to already be in that site's env-config.js.
BASE_SITE_URL=http://10.10.10.20

# Optional: override where sites.json lives (default: ./sites.json next to
# this project).
# SITES_CONFIG_PATH=
